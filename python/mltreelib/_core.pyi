class ComponentModel:
    @staticmethod
    def fit(
        data: Sequence[Sequence[float]],
        kind: str = "pca",
        n_components: int | None = None,
        standardize: bool = True,
        max_iter: int | None = None,
        tol: float | None = None,
        seed: int | None = None,
        whitening_kind: str | None = None,
        eps: float | None = None,
        rotation: str | None = None,
        promax_m: float | None = None,
        solver: str | None = None,
        l1_reg: float | None = None,
        l2_reg: float | None = None,
    ) -> ComponentModel: ...
    def transform(self, data: Sequence[Sequence[float]]) -> list[list[float]]: ...
    def inverse_transform(self, scores: Sequence[Sequence[float]]) -> list[list[float]]: ...
    def reconstruct(self, data: Sequence[Sequence[float]]) -> list[list[float]]: ...
    def score_samples(self, data: Sequence[Sequence[float]]) -> list[float]: ...
    @property
    def components(self) -> list[list[float]]: ...
    @property
    def explained_variance(self) -> list[float] | None: ...
    @property
    def explained_variance_ratio(self) -> list[float] | None: ...
    @property
    def rotation_matrix(self) -> list[list[float]] | None: ...
    @property
    def factor_correlations(self) -> list[list[float]] | None: ...
    @property
    def uniquenesses(self) -> list[float] | None: ...
    @property
    def communalities(self) -> list[float] | None: ...
    def schmid_leiman(self) -> tuple[list[list[float]], list[float]] | None: ...
    @property
    def reconstruction_error(self) -> float | None: ...
    def report(self) -> ModelReport: ...
    def to_json(self) -> str: ...
    @staticmethod
    def from_json(json: str) -> ComponentModel: ...
