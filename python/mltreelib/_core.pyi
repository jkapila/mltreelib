class AskTell:
    def __init__(
        self,
        method: str,
        bounds: Sequence[tuple[float, float]],
        *,
        population_size: int | None = ...,
        seed: int | None = ...,
        max_iterations: int | None = ...,
        max_evaluations: int | None = ...,
        tol: float | None = ...,
        ipop: bool | None = ...,
        max_restarts: int | None = ...,
        de_f: float | None = ...,
        de_cr: float | None = ...,
        pso_w: float | None = ...,
        pso_c1: float | None = ...,
        pso_c2: float | None = ...,
        moead_t: int | None = ...,
        nsga3_partitions: int | None = ...,
        island_count: int | None = ...,
        migration_interval: int | None = ...,
        migration_rate: int | None = ...,
    ) -> None: ...
    def ask(self) -> list[list[float]]: ...
    def tell(self, feedback: Sequence[float] | Sequence[Sequence[float]]) -> None: ...
    @property
    def best_x(self) -> list[float] | None: ...
    @property
    def best_value(self) -> float | None: ...
    @property
    def pareto_front(self) -> list[tuple[list[float], list[float]]]: ...
